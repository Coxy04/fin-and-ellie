# Copy to .env.local for the guest import script and `vercel dev`.
# Add the same five values in Vercel > Project > Settings > Environment Variables.

# Supabase > Project Settings > API (Data API) > Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase > Project Settings > API Keys > Secret keys (sb_secret_...)
# Server-side only. Never put this in the HTML.
SUPABASE_SECRET_KEY=sb_secret_xxx

# The password printed on the invitation. Not case-sensitive.
SITE_PASSWORD=powder

# Any long random string. Generate one with:
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=change-me

# Any long random string. Vercel Cron sends it to /api/keepalive daily so the
# free Supabase project doesn't pause from inactivity. Only needed on Vercel.
CRON_SECRET=change-me-too
